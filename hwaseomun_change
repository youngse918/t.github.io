<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>행궁동 화서문로, 얼마나 변했는가?</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;900&display=swap">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<style>
:root{--ink:#1a2233;--muted:#667085;--line:#e3e8ef;--bg:#ffffff;--soft:#f5f7fa;--blue:#6f88b4;--tan:#b9a98a;
  --c0:#8da2c4;--c1:#f59e0b;--c2:#e53935;--c3:#1e4fa0;--c4:#111c33;--c5:#cfd6e2}
*{box-sizing:border-box}
body{margin:0;font-family:"Noto Sans KR",system-ui,sans-serif;color:var(--ink);background:var(--bg);font-size:14px;line-height:1.6}
header.top{padding:24px 18px 16px;border-bottom:1px solid var(--line);background:#fff}
header.top h1{margin:0;font-size:32px;font-weight:900;letter-spacing:-.02em}
header.top p{margin:6px 0 0;color:var(--muted)}
header.top p b{color:#3a5fa8;font-weight:500}
main{max-width:1180px;margin:0 auto;padding:22px 18px 70px;display:flex;flex-direction:column;gap:22px}
.panel{background:#fff;border:1px solid var(--line);border-top:4px solid var(--blue);border-radius:14px;padding:18px 18px 20px;box-shadow:0 1px 3px rgba(20,30,60,.06);display:flex;flex-direction:column;gap:14px;min-width:0}
.panel.two{border-top-color:var(--tan);background:#faf8f3}
.stepchip{display:inline-block;font-size:11px;font-weight:700;background:#e9edf3;border-radius:5px;padding:1px 7px;margin-right:8px;vertical-align:2px}
h2{margin:0;font-size:19px;font-weight:700}
.sub{margin:-6px 0 0;color:var(--muted)}
.how{border:1px solid var(--line);background:var(--soft);border-radius:8px;padding:10px 14px;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;align-items:center;font-size:13px}
.how a{font-weight:700;color:var(--ink)}
.cats{border:1px solid var(--line);border-radius:8px;padding:12px 16px;display:flex;flex-wrap:wrap;gap:8px 22px;font-size:13px}
.cats span.i{display:inline-flex;align-items:center;gap:7px}
.chip{display:inline-block;min-width:21px;text-align:center;font-size:11px;font-weight:700;background:#e7ebf1;border-radius:4px;padding:1px 5px;color:#334}
.tablewrap{border:1px solid var(--line);border-radius:8px;overflow:auto;background:#fff}
table{border-collapse:collapse;width:100%;min-width:860px;font-size:13px}
th{background:var(--soft);text-align:left;font-size:12px;padding:9px 10px;border-bottom:1px solid var(--line);white-space:nowrap}
td{padding:6px 10px;border-bottom:1px solid var(--line);vertical-align:middle}
tbody tr:last-child td{border-bottom:0}
tbody tr.hot td{background:#eef4ff}
td.n{width:36px;font-weight:700;color:var(--muted)}
td input[type=text],td select,textarea,.info input{font:inherit;width:100%;border:1px solid var(--line);border-radius:6px;padding:6px 8px;background:#fff;color:var(--ink)}
td select{font-weight:700}td select.pick{width:100%}.fixed small{display:block;font-size:11px;color:#4c7fb0;margin-top:1px}.cls{display:flex;flex-wrap:wrap;gap:4px;align-items:center}.cls .cv{min-width:60px}.cls .ph{font-size:11px;color:#99a}.cls select{width:auto;font-size:12px;padding:3px 4px}.cls .clr{font-size:11px;border:1px solid var(--line);background:#fff;border-radius:5px;padding:2px 6px;cursor:pointer}.exb{font-size:10px;font-weight:700;color:#fff;background:#5f9a7a;border-radius:3px;padding:0 4px}
td input::placeholder{color:#a3adbd}
.fixed small{display:block;color:var(--muted);font-size:11px}
.badge{display:inline-block;font-size:11px;font-weight:700;border-radius:5px;padding:2px 9px;color:#fff;white-space:nowrap}
.badge.b0{background:var(--c0)}.badge.b1{background:var(--c1)}.badge.b2{background:var(--c2)}.badge.b3{background:var(--c3)}.badge.b4{background:var(--c4)}
.badge.b5{background:#fff;color:#8a94a6;border:1px dashed #b5bfce}.badge.b6{background:#fff;color:#c2c9d6;border:1px dashed var(--line)}
.mapcard{border:1px solid var(--line);border-radius:10px;padding:12px;background:#fff;display:flex;flex-direction:column;gap:10px;min-width:0}
.legend{display:flex;flex-wrap:wrap;gap:6px 16px;font-size:12px;align-items:center}
.legend i{display:inline-block;width:11px;height:11px;border-radius:50%;margin-right:5px;vertical-align:-1px}
.legend .sp{flex:1}
.btn{font:inherit;font-size:12px;border:1px solid var(--line);background:#fff;color:#556;padding:5px 12px;border-radius:6px;cursor:pointer}
.btn:hover{border-color:#8ea3c6}.btn.on{background:#1a2233;color:#fff;border-color:#1a2233}.btn.main{background:#1a2233;color:#fff;border-color:#1a2233;font-size:13px;padding:8px 18px}
.maptools{display:flex;gap:6px;flex-wrap:wrap;align-items:center}.maptools input{flex:1;min-width:200px;font:inherit;border:1px solid var(--line);border-radius:6px;padding:5px 8px}
.warn{background:#fff1f0;color:#a32;border-radius:6px;padding:6px 10px;font-size:12.5px}
#coords{width:100%;height:70px;font:12px ui-monospace,Menlo,monospace;border:1px solid var(--line);border-radius:6px;padding:6px}
#map{height:460px;border-radius:8px;background:#e8ecf2;position:relative;z-index:0}
.mapfail{position:absolute;inset:0;display:grid;place-items:center;color:var(--muted);text-align:center;padding:20px}
.mk{width:26px;height:26px;border-radius:50%;background:#fff;border:3px solid var(--c5);display:grid;place-items:center;font:700 12px "Noto Sans KR",sans-serif;color:var(--ink);box-shadow:0 1px 3px rgba(0,0,0,.35)}
.mk.m0{border-color:var(--c0)}.mk.m1{border-color:var(--c1)}.mk.m2{border-color:var(--c2)}.mk.m3{border-color:var(--c3)}.mk.m4{border-color:var(--c4)}.mk.m5{border-color:var(--c5)}
.mk.est{border-style:dashed}.mk.hot{transform:scale(1.25)}.mk.edit{outline:2px dashed #3a5fa8;outline-offset:2px}
.edittools{display:none;gap:8px;flex-wrap:wrap;align-items:center}
.edittools.show{display:flex}
#codebox{width:100%;height:64px;font:12px ui-monospace,Menlo,monospace;border:1px solid var(--line);border-radius:6px;padding:6px}
.stats{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}
.stat{background:var(--soft);border-left:4px solid var(--c5);border-radius:6px;padding:8px 12px}
.stat b{display:block;font-size:22px;line-height:1.2}.stat span{font-size:12px;color:var(--muted)}
.stat.s0{border-color:var(--c0)}.stat.s1{border-color:var(--c1)}.stat.s2{border-color:var(--c2)}.stat.s3{border-color:var(--c3)}.stat.s4{border-color:var(--c4)}
.q{display:flex;flex-direction:column;gap:6px}
.q>label{font-weight:700}.q>label i{font-style:normal;color:var(--muted);margin-right:8px}
.hint{font-size:12.5px;background:#fff6e5;color:#6b4410;border-radius:6px;padding:6px 10px}
textarea{min-height:84px;resize:vertical}
.stages{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.stage{display:flex;gap:9px;border:1px solid var(--line);border-radius:8px;padding:10px;cursor:pointer;background:#fff}
.stage:has(input:checked){border-color:#3a5fa8;background:#eef4ff}
.stage input{margin-top:5px}.stage b{display:block}.stage span span{font-size:12.5px;color:var(--muted)}
.info{display:flex;gap:12px;flex-wrap:wrap}.info label{font-size:12px;font-weight:700;display:block}.info div{flex:1;min-width:160px}
.defn{background:#eef4ff;border-left:4px solid #3a5fa8;border-radius:6px;padding:10px 14px}.defn p{margin:4px 0 0}
.actions{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.status{color:var(--muted);font-size:13px}
.note{color:var(--muted);font-size:12.5px}
.panel.three{border-top-color:#5f9a7a}.pair{display:grid;grid-template-columns:1fr 1fr;gap:14px}.dcard{border:1px solid var(--line);border-radius:10px;padding:12px;display:flex;flex-direction:column;gap:10px;background:#fff;min-width:0}.dcard figure{margin:0}.dcard img{width:100%;height:auto;border-radius:6px;border:1px solid var(--line);display:block}.dcard h3{font-size:15px}.cap{font-size:12px;color:var(--muted);margin-top:4px}.chk{background:#fff6e5;border-radius:8px;padding:10px 12px;font-size:13px;color:#6b4410}
@media(max-width:820px){.pair{grid-template-columns:1fr}}
@media(max-width:820px){.stats{grid-template-columns:repeat(2,1fr)}.stages{grid-template-columns:1fr 1fr}header.top h1{font-size:25px}#map{height:360px}}
@media print{.btn,.edittools,.actions,.leaflet-control-zoom{display:none!important}.panel{break-inside:avoid;box-shadow:none}#map{height:380px}}
</style>
</head>
<body>
<header class="top">
  <h1>행궁동 화서문로, 얼마나 변했는가?</h1>
  <p>2016년과 2026년 행궁동 화서문로의 업종을 비교해 변화를 지도로 나타내고, <b>젠트리피케이션이 어떻게 진행되었는지</b> 분석해 보자.</p>
</header>
<main>

<section class="panel intro">
  <h2><span class="stepchip">Data Check</span>젠트리피케이션을 데이터로 확인하기</h2>
  <p><b>탐구 질문</b> 행궁동은 언제부터, 어떻게 변화했을까? 누구를 위한 공간으로 변했는가?</p>
  <div class="defn"><b>젠트리피케이션(gentrification)이란?</b>
    <p>낙후된 지역에 새로운 상점과 방문객이 몰려 활기를 띠면서 임대료와 물가가 오르고, 원래 살던 주민과 오래 장사하던 상인이 비용 부담을 이기지 못해 떠나게 되는 현상이다.</p></div>
  <p class="note">1·2단계에서는 거리의 업종 변화를, 3단계에서는 임대료 상승과 주민 인구 자료를 해석한다. 세 가지를 종합하면 이 변화가 젠트리피케이션의 어느 단계에 해당하는지, 누가 이익을 얻고 누가 피해를 입었는지 판단할 수 있다.</p>
  <div class="info">
    <div><label for="sid">학번</label><input id="sid" type="text" inputmode="numeric" autocomplete="off"></div>
    <div><label for="sname">이름</label><input id="sname" type="text" autocomplete="off"></div>
  </div>
</section>

<section class="panel">
  <h2><span class="stepchip">1단계</span>지도화</h2>
  <p class="sub">로드뷰에서 2016년 업종을 확인해 입력하고, 2016년 분류를 고르세요.</p>
  <div class="how"><span><b>확인 방법</b> ① 오른쪽 링크로 카카오맵을 연다 → ② 지도 오른쪽 위 <b>로드뷰</b> 버튼을 누르고 화서문로 도로 위를 클릭한다 → ③ 로드뷰 화면 왼쪽 위의 촬영 시점을 <b>2016년</b>으로 바꾼다 → ④ 아래 지도의 건물 번호를 보며 같은 건물의 업종을 확인한다</span>
    <a id="kakao" href="#" target="_blank" rel="noopener">화서문로 로드뷰 열기 ↗</a></div>
  <div class="cats">
    <span class="i"><span class="chip">R</span> 주택</span>
    <span class="i"><span class="chip">N</span> 주민 대상의 상점</span>
    <span class="i"><span class="chip">T</span> 외지인 대상의 카페·상점 (프랜차이즈 제외)</span>
    <span class="i"><span class="chip">F</span> 프랜차이즈 상점</span>
    <span class="i"><span class="chip">E</span> 빈 건물</span>
  </div>
  <p class="note">한 건물에 점포가 여러 개이면 2016년 분류는 점포 순서대로 N,T,T처럼 쓰인 항목을 고른다.</p>
  <div class="tablewrap"><table id="tbl">
    <thead><tr><th>#</th><th style="min-width:200px">2016년 업종</th><th style="min-width:150px">2016 분류</th><th style="min-width:200px">2026년 업종</th><th style="min-width:150px">2026 분류</th><th>변화 유형</th></tr></thead>
    <tbody></tbody></table></div>
  <p class="note">한 건물에 가게가 여러 개면 1층에서 가장 눈에 띄는 업종을 기준으로 고른다. 도로 이름과 번호는 로드뷰 간판으로 확인한다.</p>

  <div class="mapcard">
    <div class="legend" id="legend"><span class="sp"></span><button class="btn" id="editbtn">좌표 편집 모드</button></div>
    <div class="maptools"><input id="addr" type="text" placeholder="주소로 지도 이동 (예: 수원시 팔달구 화서문로 30)" aria-label="주소 검색"><button class="btn" id="addrgo">이동</button><span class="seg" id="tilebtns"></span></div>
    <div class="note" id="tilemsg" role="status"></div>
    <div class="warn" id="unset" hidden>교사 확인: 건물 좌표가 아직 설정되지 않았다. '좌표 편집 모드'에서 마커를 건물 위치로 옮기고, 복사한 코드를 파일의 BLDG_LL에 붙여 넣는다.</div>
    <div class="edittools" id="edittools">
      <span class="note">마커를 끌어 건물 위치에 맞춘 뒤 코드를 복사해 파일의 BLDG_LL에 붙여 넣는다.</span>
      <button class="btn" id="copybtn">BLDG_LL 코드 복사</button>
      <button class="btn" id="gather">마커를 화면 중앙으로 모으기</button>
      <button class="btn on" id="editend">편집 종료</button>
      <details style="width:100%"><summary class="note" style="cursor:pointer">지도가 안 뜰 때: 좌표를 직접 붙여 넣기</summary>
        <p class="note">구글 지도에서 건물을 우클릭하면 맨 위에 나오는 숫자(예: 37.2843, 127.0108)를 눌러 복사한다. 건물 1번부터 한 줄에 하나씩 붙여 넣는다.</p>
        <textarea id="coords" placeholder="37.28430, 127.01080&#10;37.28441, 127.01092"></textarea>
        <button class="btn" id="coordok">좌표 적용</button></details>
      <textarea id="codebox" readonly></textarea>
    </div>
    <div id="map"></div>
    <div class="stats" id="stats"></div>
  </div>
</section>

<section class="panel two">
  <h2><span class="stepchip">2단계</span>분석</h2>
  <div class="q"><label for="q1"><i>1</i>가장 많이 나타난 변화 유형은 무엇인가?</label><textarea id="q1"></textarea></div>
  <div class="q"><label for="q2"><i>2</i>2016년과 비교해 주민을 위한 공간은 늘었는가, 줄었는가?</label><textarea id="q2"></textarea></div>
  <div class="q"><label for="q3"><i>3</i>행궁동 화서문로는 지금 누구를 위한 공간인가?</label><textarea id="q3"></textarea></div>
  <div class="q"><label><i>4</i>이 거리는 장소의 생애주기 중 어느 단계에 있는가? 지도 근거를 함께 쓰시오.</label>
    <div class="stages" id="stages"></div>
    <textarea id="q4" placeholder="선택한 단계의 근거를 지도와 표에서 찾아 쓴다."></textarea></div>
</section>

<section class="panel three">
  <h2><span class="stepchip">3단계</span>자료로 해석하기</h2>
  <p class="sub">두 자료를 읽고 '그래프에서 확인되는 사실'과 '그것이 뜻하는 바(해석)'를 나누어 쓴 뒤, 1·2단계 결과와 연결해 종합한다.</p>
  <div class="pair">
    <div class="dcard">
      <h3>자료 1. 행리단길 평균 임대료 상승률</h3>
      <figure><img src="data:image/jpeg;base64," alt="행리단길 평균 임대료 증가율 막대그래프. 2021년 16%, 2022년 9%, 2023년 20%, 3년 평균 15%.">
        <figcaption class="cap">자료: 수원시, 중부일보 보도(행리단길 팔달구 장안동·신풍동 일원)</figcaption></figure>
      <figure><img src="data:image/jpeg;base64," alt="행리단길과 인근 구역의 평균 임대료 상승률. 옛 경기도청사 0%, 공방거리 5%, 통닭거리 12%, 벽화거리 13%, 행리단길 15%.">
        <figcaption class="cap">자료: 수원시, 중부일보 보도</figcaption></figure>
      <div class="q"><label for="d1a"><i>읽기</i>행리단길의 임대료는 해마다 몇 % 올랐는가? 인근 구역과 비교하면 어느 정도인가?</label><textarea id="d1a"></textarea></div>
      <div class="q"><label for="d1b"><i>해석</i>임대료가 계속 오르면 기존 상인과 새로 들어오는 상인에게 각각 어떤 일이 생길 수 있는가? 1단계에서 확인한 업종 변화와 연결해 쓴다.</label><textarea id="d1b"></textarea></div>
    </div>
    <div class="dcard">
      <h3>자료 2. 행궁동 총인구 변화 (2016~2025)</h3>
      <figure><img src="data:image/jpeg;base64," alt="행궁동 총인구를 나타낸 꺾은선그래프. 2016년 12,509명, 2018년 12,718명으로 가장 많았고 이후 줄어 2025년 9,841명.">
        <figcaption class="cap">자료: 경기도주민등록인구통계(KOSIS), 각 연도 12월 31일 기준</figcaption></figure>
      <div class="q"><label for="d2a"><i>읽기</i>2016년과 2025년의 총인구는 각각 몇 명인가? 가장 많았던 해는 언제이고, 언제부터 줄었는가?</label><textarea id="d2a"></textarea></div>
      <div class="q"><label for="d2b"><i>해석</i>주민이 줄고 있다. 이 변화는 1단계에서 확인한 업종 변화와 어떻게 이어질 수 있는가?</label><textarea id="d2b"></textarea></div>
    </div>
  </div>
    <div class="q"><label for="syn"><i>종합</i>세 자료(업종 변화, 임대료 상승, 주민 인구)를 종합하면 이 변화로 누가 이익을 얻고 누가 피해를 입었는가? 2단계에서 고른 생애주기 단계를 바꾸고 싶다면 이유와 함께 쓴다.</label><textarea id="syn"></textarea></div>
  <div class="actions">
    <button class="btn main" id="submit" hidden>제출</button>
    <button class="btn" id="print">저장 (인쇄·PDF)</button>
    <button class="btn" id="reset">초기화</button>
    <span class="status" id="status" role="status"></span>
  </div>
</section>


</main>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
/* ===== 교사 설정 ===== */
const STREET='행궁동 화서문로', Y0=2016, Y1=2026;
/* 건물 1~18번 좌표 [위도, 경도]. 1·4·5·6·8·9·12·14·15·16번은 구글 지도 링크에서 얻은 값이고,
   2·3·7·10·11·13·17·18번은 주변 건물 사이를 이어 추정한 값이다(EST). 편집 모드에서 점선 마커를 끌어 맞춘 뒤 코드를 붙여 넣는다. */
const BLDG_LL=[[37.285537,127.013922],[37.285512,127.013797],[37.285487,127.013672],[37.285462,127.013547],[37.285462,127.013391],[37.285462,127.013297],[37.28545,127.0132],[37.285387,127.012953],[37.285512,127.012891],[37.2853,127.0129],[37.28555,127.01285],[37.285237,127.013234],[37.28525,127.013328],[37.285262,127.013422],[37.285262,127.013547],[37.285362,127.013672],[37.2854,127.013797],[37.28544,127.0139]];
const EST=[2,3,7,10,11,13,17,18];
/* 2026년 업종과 분류(R 주택 / N 주민 대상 / T 외지인 대상 / F 프랜차이즈 / E 빈 건물). 분류는 초안이니 확인 후 고친다. 비우면 학생이 입력한다. */
/* 학생에게 보여 줄 2016년 예시(건물 번호: 업종, 분류). 한 건물에 점포가 여러 개이면 분류를 N,T,T처럼 쓴다. */
const PRE16={5:{b:'가고 옷 수선',k:'수선',c:'N'},7:{b:'나무 공방 / 정기화물택배 / 철학원',k:'공방·택배·철학원',c:'T,N,T'},15:{b:'태성 떡방앗간',k:'방앗간',c:'N'}};
const NOW=[
 {b:'포토이즘',k:'셀프포토',c:'T'},
 {b:'골목집',k:'음식점',c:'T'},
 {b:'로지엔 드 메종(ROSIEN DE MAISON)',k:'셀프포토',c:'T'},
 {b:'코샤마트',k:'마트',c:'N'},
 {b:'가교공인중개사 / 문꼬치',k:'부동산·꼬치',c:'N,T'},
 {b:'기글드제니 / photo lab',k:'소품·셀프포토',c:'T'},
 {b:'도토리캐리커쳐 / 봉쥬르 / 포토이즘 컬러드 / 오락실',k:'캐리커처·소품·셀프포토·오락실',c:'T'},
 {b:'무인펫샵 / 달빛행궁',k:'펫샵·소품',c:'N,T'},
 {b:'레코드엠',k:'의류',c:'T'},
 {b:'샘뷰티크',k:'미용학원',c:'T'},
 {b:'매트그린',k:'카페',c:'T'},
 {b:'GS25 수원행리단길점',k:'편의점',c:'F'},
 {b:'봉쥬르 / 뽑기샵',k:'소품·뽑기',c:'T'},
 {b:'모드빈티지 / 오소(ohso)',k:'셀프포토·꽃집',c:'T'},
 {b:'공사중',k:'',c:'E'},
 {b:'뮤니버스',k:'소품',c:'T'},
 {b:'스티커사진',k:'셀프포토',c:'T'},
 {b:'존앤진피자',k:'음식점',c:'T'}];
/* 제출 받을 Google Apps Script 웹 앱 주소(선택). 비워 두면 제출 버튼이 나타나지 않는다. */
const SRC1=''; /* 자료 1 그래프의 출처·기준 연도를 적으면 그림 아래에 표시된다. 예: '출처: ○○○ (2025)' */
const SUBMIT_URL='';
/* ===================== */

const N=BLDG_LL.length;
const CATS={R:'주택',N:'주민 대상',T:'외지인 대상',F:'프랜차이즈',E:'빈 건물'};
const CHG=['변화 없음','주택 → 외지인 대상','주민 대상 → 외지인 대상','외지인 대상 → 프랜차이즈','빈 건물로 변화','미분류'];
const COL=['var(--c0)','var(--c1)','var(--c2)','var(--c3)','var(--c4)','var(--c5)'];
const STAGES=[['재생기','저렴한 임대료로 예술가와 청년 창업자가 들어오고 개성 있는 작은 가게가 생긴다.'],
 ['상권부흥기','방문객이 늘고 카페와 가게가 빠르게 늘어난다.'],
 ['상권버블기','임대료가 크게 오르고 기존 가게가 하나둘 문을 닫는다.'],
 ['상권쇠퇴기','폐업이 개업보다 많아지고 빈 건물과 프랜차이즈가 늘어난다.']];
const $=id=>document.getElementById(id);
const emptyRows=()=>Array.from({length:N},()=>({b16:'',c16:'',b26:'',c26:''}));
let S={sid:'',sname:'',rows:emptyRows(),q1:'',q2:'',q3:'',stage:'',q4:'',d1a:'',d1b:'',d2a:'',d2b:'',syn:''};
const fixedNow=i=>!!(NOW[i]&&(NOW[i].b||NOW[i].c));
const nowOf=(i)=>fixedNow(i)?{b:NOW[i].b,c:NOW[i].c}:{b:S.rows[i].b26,c:S.rows[i].c26};

const COMBO=Object.entries(CATS).map(([k,v])=>`<option value="${k}">${k} ${v}</option>`).join('')+'<option value="N,T">N+T</option>';
const COPT='<option value="">— 선택 —</option>'+COMBO;
const rep=v=>{const a=String(v||'').toUpperCase().split(/[^RNTFE]+/).filter(Boolean);if(!a.length)return '';const m=a.filter(x=>x!=='E');if(!m.length)return 'E';for(const k of 'FTNR')if(m.includes(k))return k;return ''};
const was=i=>PRE16[i+1]?PRE16[i+1]:{b:S.rows[i].b16,c:S.rows[i].c16};
const chips=c=>String(c||'').toUpperCase().split(/[^RNTFE]+/).filter(Boolean).map(x=>`<span class="chip">${x}</span>`).join(' ');
function chgIdx(a,b){a=rep(a);b=rep(b);
  if(!a||!b) return -1;
  if(a===b) return 0;
  if(b==='E') return 4;
  if(a==='R'&&b==='T') return 1;
  if(a==='N'&&(b==='T'||b==='F')) return 2;
  if(a==='T'&&b==='F') return 3;
  return 5;
}
const KEY='hwaseomun-change-v1';
function loadLocal(){try{const j=JSON.parse(localStorage.getItem(KEY)||'null');if(j&&j.rows&&j.rows.length===N)S=Object.assign(S,j)}catch(e){}}
let t0;function saveLocal(){clearTimeout(t0);t0=setTimeout(()=>{try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){}},300)}
const opts='<option value="">— 선택 —</option>'+Object.entries(CATS).map(([k,v])=>`<option value="${k}">${k} ${v}</option>`).join('');
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

function build(){
  $('kakao').href='https://map.kakao.com/?q='+encodeURIComponent('수원시 팔달구 화서문로 16');
  const tb=$('tbl').tBodies[0];tb.innerHTML='';
  for(let i=0;i<N;i++){
    const tr=document.createElement('tr');tr.id='r'+i;
    const now=fixedNow(i)?`<td class="fixed">${esc(NOW[i].b)}${NOW[i].k?`<small>${esc(NOW[i].k)}</small>`:''}</td><td>${NOW[i].c?chips(NOW[i].c):''}</td>`
      :`<td><input type="text" data-i="${i}" data-k="b26" placeholder="로드뷰 확인 후 입력" aria-label="${i+1}번 ${Y1}년 업종"></td><td><input type="text" data-i="${i}" data-k="c26" placeholder="예: N,T" maxlength="20" aria-label="${i+1}번 ${Y1} 분류"></td>`;
    const ex=PRE16[i+1];
    const old=ex?`<td class="fixed">${esc(ex.b)}${ex.k?`<small>${esc(ex.k)}</small>`:''}</td><td>${chips(ex.c)}</td>`
      :`<td><input type="text" data-i="${i}" data-k="b16" placeholder="로드뷰 확인 후 입력" aria-label="${i+1}번 ${Y0}년 업종"></td><td><select class="pick" data-ci="${i}" aria-label="${i+1}번 ${Y0} 분류">${COPT}</select></td>`;
    tr.innerHTML=`<td class="n">${i+1}</td>${old}${now}<td id="chg${i}"></td>`;
    tb.appendChild(tr);
  }
  tb.addEventListener('change',e=>{const t=e.target;if(!t.classList.contains('pick'))return;S.rows[+t.dataset.ci].c16=t.value;refresh();saveLocal()});
  tb.addEventListener('input',e=>{const t=e.target,i=t.dataset.i;if(i==null)return;S.rows[i][t.dataset.k]=t.value;refresh();saveLocal()});
  tb.addEventListener('focusin',e=>{const i=e.target.dataset.i;if(i!=null)hot(+i)});
  $('legend').insertAdjacentHTML('afterbegin',CHG.map((k,i)=>`<span><i style="background:${COL[i]}"></i>${k.replace('미분류','미분류')}</span>`).join(''));
  $('stats').innerHTML=CHG.slice(0,5).map((k,i)=>`<div class="stat s${i}"><b id="st${i}">0</b><span>${k}</span></div>`).join('');
  $('stages').innerHTML=STAGES.map((s,i)=>`<label class="stage"><input type="radio" name="stage" value="${s[0]}"><span><b>${i+1}. ${s[0]}</b><span>${s[1]}</span></span></label>`).join('');
  $('stages').addEventListener('change',e=>{S.stage=e.target.value;saveLocal()});
  for(const k of ['q1','q2','q3','q4','sid','sname','d1a','d1b','d2a','d2b','syn']) $(k).addEventListener('input',e=>{S[k]=e.target.value;saveLocal()});
}
const paintCls=i=>{const d=document.querySelector(`select[data-ci="${i}"]`);if(d)d.value=S.rows[i].c16||''};
function fill(){
  for(const k of ['q1','q2','q3','q4','sid','sname','d1a','d1b','d2a','d2b','syn']) $(k).value=S[k]||'';
  document.querySelectorAll('#tbl [data-i]').forEach(el=>el.value=S.rows[el.dataset.i][el.dataset.k]||'');
  for(let i=0;i<N;i++)paintCls(i);
  document.querySelectorAll('input[name=stage]').forEach(r=>r.checked=r.value===S.stage);
}

/* ---- map ---- */
let map=null, markers=[], editing=false, hotI=-1;
const DEFAULT0=[37.28440,127.01020];
const UNSET=BLDG_LL[0][0]===DEFAULT0[0]&&BLDG_LL[0][1]===DEFAULT0[1];
const TILES=[
 {n:'지도',u:'https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png',a:'&copy; OpenStreetMap contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',sub:'abcd',max:20},
 {n:'위성',u:'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',a:'Tiles &copy; Esri',max:19},
 {n:'OSM 지도',u:'https://tile.openstreetmap.org/{z}/{x}/{y}.png',a:'&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',max:19}];
let tileLayer=null, tileK=-1, tileOk=0, tileErr=0;
function setTiles(k,auto){
  if(!map)return;
  if(tileLayer)map.removeLayer(tileLayer);
  const t=TILES[k];tileK=k;tileOk=0;tileErr=0;
  tileLayer=L.tileLayer(t.u,{maxZoom:t.max,subdomains:t.sub||'abc',attribution:t.a}).addTo(map);
  tileLayer.on('tileload',()=>{tileOk++;if(tileOk===1)$('tilemsg').textContent=''});
  tileLayer.on('tileerror',()=>{tileErr++});
  document.querySelectorAll('#tilebtns .btn').forEach((b,j)=>b.classList.toggle('on',j===k));
  $('tilemsg').textContent=auto?'지도를 불러오지 못해 다른 지도로 바꿨다.':'';
  setTimeout(()=>{
    if(tileK!==k||tileOk>0)return;
    if(k<TILES.length-1)setTiles(k+1,true);
    else $('tilemsg').textContent='지도 타일을 불러오지 못했다. 이 파일을 크롬 같은 브라우저로 직접 열었는지, 인터넷이 연결되어 있는지 확인한다. 안 되면 아래 \'좌표를 직접 붙여 넣기\'를 쓴다.';
  },3500);
}
function gather(){
  if(!map)return;const b=map.getBounds(),c=map.getCenter(),h=b.getNorth()-b.getSouth(),w=b.getEast()-b.getWest();
  BLDG_LL.forEach((_,i)=>{const p=[+(c.lat+(i%2?1:-1)*h*0.06).toFixed(6),+(b.getWest()+w*(0.12+0.76*i/(N-1))).toFixed(6)];BLDG_LL[i]=p;markers[i].setLatLng(p)});
  $('codebox').value=code();
}
function initMap(){
  $('unset').hidden=!UNSET;
  if(!window.L){$('map').innerHTML='<div class="mapfail">지도 라이브러리를 불러오지 못했다. 이 파일을 크롬 같은 브라우저로 직접 열고, 인터넷 연결을 확인한 뒤 새로고침한다. 표 입력은 그대로 할 수 있다.</div>';return}
  const c=UNSET?[37.2819,127.0137]:BLDG_LL.reduce((a,p)=>[a[0]+p[0]/N,a[1]+p[1]/N],[0,0]);
  map=L.map('map',{scrollWheelZoom:false}).setView(c,UNSET?17:19);
  $('tilebtns').innerHTML=TILES.map((t,k)=>`<button class="btn" data-k="${k}">${t.n}</button>`).join('');
  $('tilebtns').onclick=e=>{const b=e.target.closest('[data-k]');if(b)setTiles(+b.dataset.k)};
  setTiles(0);
  BLDG_LL.forEach((p,i)=>{
    const m=L.marker(p,{icon:icon(i),draggable:false,keyboard:true,title:(i+1)+'번 건물'}).addTo(map);
    m.on('click',()=>{if(editing)return;hot(i);const r=$('r'+i);r.scrollIntoView({block:'center',behavior:'smooth'});const f=r.querySelector('input');if(f)f.focus({preventScroll:true})});
    m.on('dragend',()=>{const q=m.getLatLng();BLDG_LL[i]=[+q.lat.toFixed(6),+q.lng.toFixed(6)];$('codebox').value=code()});
    markers.push(m);
  });
  if(UNSET)gather();
  $('addrgo').onclick=search;$('addr').addEventListener('keydown',e=>{if(e.key==='Enter')search()});
  $('gather').onclick=gather;
  $('coordok').onclick=()=>{
    const L2=$('coords').value.split('\n').map(l=>l.match(/(-?\d+\.\d+)\s*[, ]\s*(-?\d+\.\d+)/)).filter(Boolean).map(m=>[+(+m[1]).toFixed(6),+(+m[2]).toFixed(6)]);
    if(!L2.length){$('tilemsg').textContent='좌표를 읽지 못했다. 한 줄에 "위도, 경도" 하나씩 적는다.';return}
    L2.slice(0,N).forEach((p,i)=>{BLDG_LL[i]=p;markers[i].setLatLng(p)});
    map.setView(L2[0],18);$('codebox').value=code();$('tilemsg').textContent=L2.length+'개 좌표를 적용했다.';
  };
}
async function search(){
  const q=$('addr').value.trim();if(!q||!map)return;
  $('tilemsg').textContent='검색 중…';
  try{
    const r=await fetch('https://nominatim.openstreetmap.org/search?format=json&limit=1&accept-language=ko&q='+encodeURIComponent(q));
    const j=await r.json();
    if(!j.length){$('tilemsg').textContent='검색 결과가 없다. 지도를 끌어 직접 이동한다.';return}
    map.setView([+j[0].lat,+j[0].lon],18);$('tilemsg').textContent='';
  }catch(e){$('tilemsg').textContent='주소 검색을 쓸 수 없다. 지도를 끌어 직접 이동한다.'}
}
function icon(i){
  const k=chgIdx(was(i).c,nowOf(i).c);
  return L.divIcon({className:'',html:`<div class="mk ${k<0?'m5':'m'+k} ${i===hotI?'hot':''} ${editing?'edit':''} ${editing&&EST.includes(i+1)?'est':''}">${i+1}</div>`,iconSize:[26,26],iconAnchor:[13,13]});
}
function drawMarkers(){markers.forEach((m,i)=>m.setIcon(icon(i)))}
function hot(i){hotI=i;document.querySelectorAll('#tbl tbody tr').forEach((r,j)=>r.classList.toggle('hot',j===i));drawMarkers()}
const code=()=>'const BLDG_LL='+JSON.stringify(BLDG_LL)+';';
function setEdit(on){
  editing=on;$('edittools').classList.toggle('show',on);$('editbtn').classList.toggle('on',on);
  markers.forEach(m=>on?m.dragging.enable():m.dragging.disable());
  if(map){on?map.scrollWheelZoom.enable():map.scrollWheelZoom.disable();
    if(on&&markers.some(m=>!map.getBounds().contains(m.getLatLng())))gather();}
  if(on)$('codebox').value=code();drawMarkers();
}
$('editbtn').onclick=()=>setEdit(!editing);
$('editend').onclick=()=>setEdit(false);
$('copybtn').onclick=async()=>{
  try{await navigator.clipboard.writeText(code());$('copybtn').textContent='복사했다'}catch(e){$('codebox').select();$('copybtn').textContent='아래 코드를 직접 복사한다'}
  setTimeout(()=>$('copybtn').textContent='BLDG_LL 코드 복사',2000);
};

/* ---- derived ---- */
function refresh(){
  const cnt=[0,0,0,0,0,0];
  for(let i=0;i<N;i++){
    const k=chgIdx(was(i).c,nowOf(i).c);
    $('chg'+i).innerHTML=k<0?'<span class="badge b6">—</span>':`<span class="badge b${k}">${CHG[k]}</span>`;
    if(k>=0)cnt[k]++;
  }
  for(let i=0;i<5;i++)$('st'+i).textContent=cnt[i];
  drawMarkers();
}

/* ---- actions ---- */
const say=m=>{$('status').textContent=m};
$('print').onclick=()=>window.print();
let rs=false;
$('reset').onclick=()=>{
  if(!rs){rs=true;$('reset').textContent='정말 지우기';say('입력한 내용이 모두 지워진다. 한 번 더 누르면 지운다.');setTimeout(()=>{rs=false;$('reset').textContent='초기화'},4000);return}
  rs=false;$('reset').textContent='초기화';S={sid:S.sid,sname:S.sname,rows:emptyRows(),q1:'',q2:'',q3:'',stage:'',q4:'',d1a:'',d1b:'',d2a:'',d2b:'',syn:''};fill();refresh();saveLocal();say('지웠다.');
};
if(SUBMIT_URL){
  $('submit').hidden=false;
  $('submit').onclick=async()=>{
    if(!S.sid.trim()||!S.sname.trim()){say('학번과 이름을 먼저 적는다.');$('sid').focus();return}
    const rows=S.rows.map((r,i)=>({n:i+1,b16:was(i).b,c16:was(i).c,b26:nowOf(i).b,c26:nowOf(i).c,chg:CHG[chgIdx(was(i).c,nowOf(i).c)]||''}));
    try{await fetch(SUBMIT_URL,{method:'POST',mode:'no-cors',headers:{'Content-Type':'text/plain'},body:JSON.stringify({sid:S.sid,sname:S.sname,rows,q1:S.q1,q2:S.q2,q3:S.q3,stage:S.stage,q4:S.q4,d1a:S.d1a,d1b:S.d1b,d2a:S.d2a,d2b:S.d2b,syn:S.syn,at:new Date().toISOString()})});say('제출했다. ('+new Date().toLocaleString('ko-KR')+') 고쳐서 다시 제출하면 새 줄로 쌓인다.')}
    catch(e){say('제출하지 못했다. 인터넷 연결을 확인한다.')}
  };
}
if(SRC1)$('src1').textContent=SRC1;
build();loadLocal();fill();initMap();refresh();
</script>
</body>
</html>
